# Managed-By: liqun-helper
[Unit]
Description=Liqun Helper Realm IPv4 TCP Relay (%i)
After=network-online.target networking.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
TimeoutStartSec=90
ExecStartPre=/usr/local/lib/liqun-helper/realm-preflight.sh %i
ExecStart=/usr/local/lib/liqun-helper/realm-exec.sh %i
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
