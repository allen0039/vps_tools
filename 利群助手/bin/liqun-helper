#!/usr/bin/env python3
# Managed-By: liqun-helper
"""Launcher for liqun-helper supporting both installed (/usr/local/lib/liqun-helper) and repo runs."""

from pathlib import Path
import sys

SCRIPT_PATH = Path(__file__).resolve()
CANDIDATE_ROOTS = [
    SCRIPT_PATH.parent.parent,
    Path("/usr/local/lib/liqun-helper"),
]

for root in CANDIDATE_ROOTS:
    if (root / "liqun_helper" / "__init__.py").is_file():
        root_str = str(root)
        if root_str not in sys.path:
            sys.path.insert(0, root_str)
        break

from liqun_helper.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
