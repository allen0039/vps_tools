# managed-by=vpspc
[Unit]
Description=VPSPC restricted host update helper
Requires=vps-audit-update-helper.socket
After=vps-audit-update-helper.socket

[Service]
Type=simple
User=root
Group=root
UMask=0077
Environment=PYTHONPATH=/opt/vps-audit
ExecStart=/usr/local/lib/vpspc-updater/vpspc-host-updater.py --socket-activated
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15min
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/vps-audit /usr/local/lib/vpspc-updater
ReadWritePaths=/opt/vps-audit /opt/.vps-audit-update /var/lib/vps-audit /run/vpspc /run/docker.sock
SystemCallArchitectures=native
SystemCallFilter=@system-service
