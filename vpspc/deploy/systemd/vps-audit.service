[Unit]
Description=VPS user behavior audit cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/vps-audit/venv/bin/vps-audit-runner --config /etc/vps-audit/config.json run
TimeoutStartSec=180
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/vps-audit /var/log
ReadWritePaths=@STATE_DIR@ @REPORT_DIR@
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
