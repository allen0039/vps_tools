# managed-by=vpspc
[Unit]
Description=VPSPC authenticated node event receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStart=/opt/vps-audit/venv/bin/vps-audit-nodes --config /etc/vps-audit/config.json serve
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/vps-audit /opt/vps-audit/manager/deploy/node
ReadWritePaths=@STATE_DIR@ @BEHAVIOR_ARCHIVE_DIR@ /run/vpspc
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
