# managed-by=vpspc
[Unit]
Description=VPSPC Telegram management bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
UMask=0077
Environment=VPSPC_TELEGRAM_IPV4=1
ExecStart=/opt/vps-audit/venv/bin/vps-audit-bot --config /etc/vps-audit/config.json
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/vps-audit @STATE_DIR@ @BEHAVIOR_ARCHIVE_DIR@ /run/vpspc
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
