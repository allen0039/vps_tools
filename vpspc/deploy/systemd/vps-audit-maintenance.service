# managed-by=vpspc
[Unit]
Description=VPSPC maintenance coordinator
After=network-online.target vps-audit-update-helper.socket
Wants=network-online.target vps-audit-update-helper.socket

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStart=/opt/vps-audit/venv/bin/vps-audit-maintenance --config /etc/vps-audit/config.json
Restart=always
RestartSec=3s
TimeoutStopSec=20s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/vps-audit
ReadWritePaths=@STATE_DIR@ /run/vpspc
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
