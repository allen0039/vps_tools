[Unit]
Description=VPSPC Web management console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStart=/opt/vps-audit/venv/bin/vps-audit-web --config /etc/vps-audit/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/vps-audit
ReadWritePaths=@STATE_DIR@ @REPORT_DIR@ @BEHAVIOR_ARCHIVE_DIR@
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
