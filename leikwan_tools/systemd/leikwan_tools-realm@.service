# Managed-By: leikwan_tools
[Unit]
Description=leikwan_tools Realm IPv4 TCP Relay (%i)
After=network-online.target networking.service leikwan_tools-routing.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
TimeoutStartSec=90
ExecStartPre=/usr/local/lib/leikwan_tools/realm-preflight.sh %i
ExecStart=/usr/local/lib/leikwan_tools/realm-exec.sh %i
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
