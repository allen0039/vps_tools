#!/usr/bin/env python3
# Managed-By: leikwan_tools
"""Launcher for leikwan_tools supporting both installed (/usr/local/lib/leikwan_tools) and repo runs."""

from pathlib import Path
import sys

SCRIPT_PATH = Path(__file__).resolve()
CANDIDATE_ROOTS = [
    SCRIPT_PATH.parent.parent,
    Path("/usr/local/lib/leikwan_tools"),
]

for root in CANDIDATE_ROOTS:
    if (root / "leikwan_tools" / "__init__.py").is_file():
        root_str = str(root)
        if root_str not in sys.path:
            sys.path.insert(0, root_str)
        break

from leikwan_tools.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
